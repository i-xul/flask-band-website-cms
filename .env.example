# Flask Band Website CMS
# Environment variable template
#
# Copy the required values to the environment used by the application.
# Never store real secrets in this file.

# Application environment
# development | production
APP_ENV=development

# Flask secret key
# Required in production.
# Generate a unique, cryptographically strong value for production.
SECRET_KEY=

# Database
# Development example:
DATABASE_URL=sqlite:///band_website.db

# Rate-limit storage
# Development may use memory://.
# Production must use persistent/shared storage such as Redis.
RATELIMIT_STORAGE_URI=memory://

# Trusted HTTP Host headers
# Required in production.
# Multiple hosts are comma-separated.
# Example:
# TRUSTED_HOSTS=example.com,www.example.com
TRUSTED_HOSTS=